// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ CORE ENTITIES ============

model Location {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String  @db.Text
  shortDesc   String? @db.VarChar(300)

  atoll  String
  island String?

  // Display fields the redesign reads. All nullable — admin decides what to publish.
  region               String? @db.VarChar(120) // "North-west · UNESCO biosphere"
  knownFor             String? @db.VarChar(120) // "Mantas, house reefs"
  bestMonths           String? @db.VarChar(80) // "January to April"
  seasonHighlightLabel String? @db.VarChar(40) // names the middle season band, e.g. "Mantas"
  latitude             Float?
  longitude            Float?

  // Transfer info
  transferTime Int? // Duration in minutes
  transferType TransferType? // Primary transfer type
  transferInfo String?       @db.Text // Additional transfer details

  images     LocationImage[]
  coverImage String?

  accommodations Accommodation[]
  activities     Activity[]
  packages       Package[]
  faqs           FaqItem[]
  seasonMonths   SeasonMonth[]
  stayTypes      LocationStayType[]

  isFeatured Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([atoll])
  @@index([isActive])
  @@index([isFeatured])
}

model LocationImage {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

enum TransferType {
  SPEEDBOAT
  SEAPLANE
  DOMESTIC_FLIGHT
  FERRY
  YACHT
}

model Accommodation {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  type        AccommodationType
  shortDesc   String?           @db.VarChar(300)
  description String            @db.Text

  starRating Int? @db.SmallInt

  // Display fields the redesign reads. Nullable; the front end drops the row when absent.
  // Occupancy. Caps the Guests selector on any package sold against this stay,
  // so a villa that sleeps three cannot be enquired about for six. Null means
  // unknown, and the selector falls back to the package's own maxGuests.
  maxAdults    Int?    @db.SmallInt
  maxChildren  Int?    @db.SmallInt
  houseReef    String? @db.VarChar(160) // "Yes — 9m from the villa ladder"
  suits        String? @db.VarChar(160) // "Couples, snorkellers, divers"
  boardOptions String? @db.VarChar(160) // "Half-board or full-board"
  absentNote   String? @db.Text // what is NOT here: "No kids' club, patchy villa wifi"

  images     AccommodationImage[]
  coverImage String?

  locationId String
  location   Location        @relation(fields: [locationId], references: [id])
  packages   Package[]
  roomTypes  RoomType[]
  facilities Facility[]
  faqs       FaqItem[]
  blackouts  BlackoutRange[]

  contactEmail String?
  contactPhone String?

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([type])
  @@index([isActive])
}

model AccommodationImage {
  id              String        @id @default(cuid())
  url             String
  alt             String?
  sortOrder       Int           @default(0)
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@index([accommodationId])
}

enum AccommodationType {
  RESORT
  GUESTHOUSE
  HOTEL
  LIVEABOARD
}

model Activity {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  shortDesc   String?          @db.VarChar(300)
  description String           @db.Text
  category    ActivityCategory
  duration    Int? // Duration in minutes

  images     ActivityImage[]
  coverImage String?

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  // Dual pricing
  localPrice         Float? // MVR price for locals
  internationalPrice Float? // USD price for internationals

  packageActivities PackageActivity[]

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([category])
  @@index([isActive])
}

model ActivityImage {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

enum ActivityCategory {
  WATER_SPORTS
  DIVING
  SNORKELING
  FISHING
  EXCURSION
  WELLNESS
  CULTURAL
  ADVENTURE
}

// ============ PACKAGES ============

model Package {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  shortDesc   String? @db.VarChar(300)
  description String  @db.Text
  // Stored as a JSON array of strings (MySQL has no scalar-list type).
  highlights  Json    @default("[]")

  // How long the package is. One number, not a range: it used to be minNights
  // (the sold length) plus an optional maxNights ceiling, which put a Nights
  // dropdown in front of guests offering lengths that were never really on sale.
  // A 4-night package is four nights; the arrival date is the only thing a guest
  // chooses, and the departure follows from it.
  nights    Int  @default(1)
  maxGuests Int?

  // Display fields the redesign reads. All nullable — a null drops its spec row.
  mealPlan   String?     @db.VarChar(160) // "Half-board, one à-la-carte night"
  boardBasis BoardBasis? // structured form of the above, for filtering
  badge      String?     @db.VarChar(40) // card pill: "All-inclusive", "Best value"
  bestMonths String?     @db.VarChar(80) // "January to April"
  longBlurb  String?     @db.Text // detail overview; falls back to description

  // Travel windows
  bookingWindowStart DateTime?
  bookingWindowEnd   DateTime?
  travelWindowStart  DateTime?
  travelWindowEnd    DateTime?

  // Additional info
  terms              String? @db.Text
  cancellationPolicy String? @db.Text
  bookingInfo        String? @db.Text

  images     PackageImage[]
  coverImage String?

  locationId      String
  location        Location      @relation(fields: [locationId], references: [id])
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id])

  pricing    PackagePricing[]
  inclusions PackageInclusion[]
  activities PackageActivity[]
  offers     Offer[]
  inquiries  Inquiry[]
  faqs       FaqItem[]
  blackouts  BlackoutRange[]
  tags       PackageTag[]

  isFeatured Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([locationId])
  @@index([accommodationId])
  @@index([isActive])
  @@index([isFeatured])
}

model PackageImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model PackagePricing {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  market    Market

  // WHOLE-PACKAGE totals, not nightly rates and not per person.
  //
  // basePrice is THE price of the package, whatever the party size. It used to
  // be the single-occupancy total, sitting beside a couplePrice that was the
  // total for two — and since the site quoted the couple figure, that is the one
  // that survived: the migration copies couplePrice into basePrice so nothing
  // the client advertises changes.
  basePrice       Float // total for the package
  extraAdultPrice Float? // Additional adult
  childPrice      Float? // Child (typically 2-11)
  infantPrice     Float? // Infant (typically 0-2)

  // Supplements
  singleSupplement Float? // Extra charge for single occupancy

  // Age definitions
  childAgeMin Int @default(2)
  childAgeMax Int @default(11)

  // Validity
  validFrom  DateTime?
  validUntil DateTime?
  notes      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId, market])
  @@index([packageId])
}

enum Market {
  LOCAL
  INTERNATIONAL
}

model PackageInclusion {
  id        String            @id @default(cuid())
  packageId String
  package   Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category  InclusionCategory
  item      String // What's included
  details   String? // Additional details
  sortOrder Int               @default(0)

  @@index([packageId])
}

enum InclusionCategory {
  ACCOMMODATION
  MEALS
  TRANSFER
  ACTIVITY
  EQUIPMENT
  SERVICE
  // Green tax, GST, service charge — the government and resort charges that
  // guests ask about most and that used to be stated only as a hardcoded
  // "Green tax, paid on arrival" under Not included, whether or not it was true
  // of the package. Now a line staff can put on either side.
  TAXES
}

model PackageActivity {
  id         String   @id @default(cuid())
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  isIncluded Boolean  @default(true) // true = included in price, false = optional add-on
  // Optional package-specific line, shown instead of activity.shortDesc when set.
  note       String?  @db.Text
  sortOrder  Int      @default(0)

  @@unique([packageId, activityId])
  @@index([packageId])
  @@index([activityId])
}

// ============ OFFERS ============

model Offer {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  badge       String? // Display badge like "15% OFF", "HONEYMOON"

  discountType  DiscountType
  discountValue Float // Percentage or fixed amount
  code          String? // Promo code if applicable

  validFrom  DateTime
  validUntil DateTime

  // Conditions
  minNights Int?
  minGuests Int?
  market    Market? // null = applies to all markets

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([isActive])
  @@index([validFrom, validUntil])
  @@index([code])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_NIGHTS
}

// ============ INQUIRIES ============

model Inquiry {
  id          String  @id @default(cuid())
  name        String
  email       String
  phone       String?
  nationality String?

  packageId   String?
  package     Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageName String? // Store name in case package is deleted

  checkIn  DateTime?
  checkOut DateTime?
  adults   Int       @default(2)
  children Int       @default(0)
  infants  Int       @default(0)

  message         String  @db.Text
  specialRequests String? @db.Text

  arrivalFlight   String?
  departureFlight String?

  market Market

  // Estimated prices at time of inquiry
  estimatedPriceUSD Float?
  estimatedPriceMVR Float?

  status InquiryStatus @default(NEW)
  notes  String?       @db.Text

  respondedAt DateTime?
  respondedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([status])
  @@index([market])
  @@index([createdAt])
}

enum InquiryStatus {
  NEW
  CONTACTED
  NEGOTIATING
  BOOKED
  CANCELLED
  CLOSED
}

// ============ SITE SETTINGS ============

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ============ AVAILABILITY ============

/// Closures and sold-out stretches. Attach to a package or an accommodation.
/// Availability is windows + blackouts only — there is deliberately no per-date
/// capacity, because we confirm with the island rather than run live inventory.
model BlackoutRange {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  reason    String?  @db.VarChar(160)

  packageId       String?
  package         Package?       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([packageId])
  @@index([accommodationId])
  @@index([startDate, endDate])
}

// ============ EDITORIAL ============

/// "Worth knowing" question/answer rows. Written once, attached where it belongs.
model FaqItem {
  id        String @id @default(cuid())
  question  String @db.VarChar(300)
  answer    String @db.Text
  sortOrder Int    @default(0)

  packageId       String?
  package         Package?       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  accommodationId String?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  locationId      String?
  location        Location?      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([accommodationId])
  @@index([locationId])
}

/// Replaces the old flat `Accommodation.roomTypes` JSON array of strings.
model RoomType {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(120)
  blurb       String? @db.Text
  nightlyFrom Float?
  size        String? @db.VarChar(40) // "78 m²"
  sleeps      String? @db.VarChar(60) // "2 adults + 1 child"
  access      String? @db.VarChar(60) // "Ladder to lagoon"
  sortOrder   Int     @default(0)

  @@index([accommodationId])
}

/// Replaces the old flat `Accommodation.amenities` JSON array. Grouped, because the
/// design shows two labelled columns rather than one undifferentiated list.
model Facility {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  group     String @db.VarChar(60) // "Eating and drinking", "In the water"
  item      String @db.VarChar(160)
  sortOrder Int    @default(0)

  @@index([accommodationId])
}

// ============ SEASONS ============

model SeasonMonth {
  id         String      @id @default(cuid())
  locationId String
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  month      Int         @db.SmallInt // 1-12
  state      SeasonState

  @@unique([locationId, month])
  @@index([locationId])
}

enum SeasonState {
  BEST
  HIGHLIGHT // the location-specific band, labelled by Location.seasonHighlightLabel
  WETTER
}

// ============ STAY TYPES ============

/// The five kinds of night. Reference content — never sliced by density, because
/// these sections carry the page when the catalogue is thin.
model StayType {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(80) // "Water villa"
  slug        String  @unique
  band        String  @db.VarChar(80) // "Over the reef"
  blurb       String  @db.Text
  nightlyFrom Float?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  locations LocationStayType[]
}

/// Per-location overrides — Baa's guesthouses start at $95, not the global $65.
model LocationStayType {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  stayTypeId String
  stayType   StayType @relation(fields: [stayTypeId], references: [id], onDelete: Cascade)

  blurb       String? @db.Text
  nightlyFrom Float?
  sortOrder   Int     @default(0)

  @@unique([locationId, stayTypeId])
  @@index([locationId])
  @@index([stayTypeId])
}

// ============ TAGS ============

/// Filter pills on the listings. Distinct from `Package.badge`, which is the single
/// card pill — the designs use the two for different jobs.
model Tag {
  id        String @id @default(cuid())
  name      String @db.VarChar(60) // "Diving", "Honeymoon", "Family"
  slug      String @unique
  sortOrder Int    @default(0)

  packages PackageTag[]
}

model PackageTag {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([packageId, tagId])
  @@index([packageId])
  @@index([tagId])
}

enum BoardBasis {
  ROOM_ONLY
  BED_AND_BREAKFAST
  HALF_BOARD
  FULL_BOARD
  ALL_INCLUSIVE
}
